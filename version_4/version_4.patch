+            if B[i] is not None:
+                C.ccx(k2, B[i], L[i])
+            if c >> i & 1:
+                C.cx(k1, L[i])
+            if (2 * c) >> i & 1:
+                C.cx(k2, L[i])
+        C.cx(k2, k1)
+
